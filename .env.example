# 服务器
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=loopback

# 公开站点域名
SITE_ORIGIN=https://www.lxenelectric.com
ALLOWED_ORIGINS=https://www.lxenelectric.com,https://lxenelectric.com

# 数据库与存储
DB_PATH=data/longxiang.db
UPLOAD_DIR=/var/lib/longxiang/uploads
UPLOAD_PUBLIC_PATH=uploads
BACKUP_DIR=/var/backups/longxiang

# 后台鉴权
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP，可选。留空表示不发送邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INQUIRY_NOTIFY_TO=
